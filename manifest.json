{
  "manifest_version": 2,
  "name": "Zotero Skimming",
  "version": "0.1.0",
  "description": "Automatic annotations of PDF inside Zotero for skimming academic literature",
  "author": "00sapo",
  "icons": {
    "48": "assets/book reader.svg",
    "96": "assets/book reader.svg"
  },
  "homepage_url": "https://codeberg.org/00sapo/zotero-skimming",
  "applications": {
    "zotero": {
      "id": "zotero-skimming@example.org",
      "update_url": "https://raw.githubusercontent.com/00sapo/zotero-skimming/main/updates.json",
      "strict_min_version": "9.0",
      "strict_max_version": "9.*"
    }
  }
}
